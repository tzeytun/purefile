# Copy to .env to change settings. Never commit your real .env.
# docker compose reads this file; local runs read it too (see purefile/config.py).

# Host port for docker compose
PUREFILE_PORT=8000

# Upload limits, in megabytes
PUREFILE_MAX_IMAGE_MB=50
PUREFILE_MAX_VIDEO_MB=1024

# Files older than this many seconds are deleted by the cleanup job
PUREFILE_FILE_TTL_SECONDS=600
# How often the cleanup job runs, in seconds
PUREFILE_SWEEP_INTERVAL_SECONDS=60

# Files processed in parallel (further uploads wait)
PUREFILE_MAX_CONCURRENT_JOBS=4
# Timeout for one exiftool/ffmpeg/c2patool call, in seconds
PUREFILE_TOOL_TIMEOUT_SECONDS=600

# Size of the in-memory /tmp that holds files while they are processed (docker compose).
# It must fit the largest video you allow, a few times over.
PUREFILE_TMPFS_SIZE=3g

# --- Local development only (not used by docker compose) ---
# Working directory for in-flight files (default: system temp dir + /purefile)
# PUREFILE_TMP_DIR=
# Paths to the external tools if they are not on PATH
# PUREFILE_EXIFTOOL_PATH=
# PUREFILE_FFMPEG_PATH=
# PUREFILE_FFPROBE_PATH=
# PUREFILE_C2PATOOL_PATH=
